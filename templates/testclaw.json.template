{
  "gateway": {
    "mode": "local",
    "bind": "127.0.0.1",
    "port": 18789
  },
  "plugins": {
    "entries": {
      "searxng": { "enabled": false },
      "deepseek": { "enabled": true },
      "memory-core": { "enabled": true }
    }
  },
  "models": {
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "apiKey": "__DEEPSEEK_API_KEY__"
      }
    }
  },
  "agents": {
    "defaults": {
      "model": "deepseek/deepseek-v4-flash",
      "thinkingDefault": "off"
    }
  },
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    }
  }
}

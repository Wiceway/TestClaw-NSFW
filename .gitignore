# ---- secrets (never commit) ----
/.env
*.env
!*.env.template
/templates/*.json

# ---- installer-created runtime state, at the repo root ONLY ----
# Leading slashes are essential: bare "config/" would also match
# app/dist/config/ and silently strip runtime code from the bundle.
/config/
/state/
/logs/
/data/
/workspace/
/runtime/
/node/
/node_modules/

# ---- noise ----
*.log
*.bak
*.tmp
.cache/

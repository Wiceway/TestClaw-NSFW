{
  "name": "@testclaw/memory-core",
  "version": "2026.9.5",
  "private": true,
  "description": "Testclaw core memory search plugin",
  "type": "module",
  "exports": {
    "./api.js": "./api.ts",
    "./session-search-visibility-api.js": "./session-search-visibility-api.ts",
    "./worker-api.js": "./worker-api.ts"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "json5": "2.2.3",
    "p-limit": "7.3.2",
    "typebox": "1.3.30"
  },
  "devDependencies": {
    "@testclaw/plugin-sdk": "workspace:*",
    "testclaw": "workspace:*"
  },
  "peerDependencies": {
    "testclaw": ">=2026.9.5"
  },
  "peerDependenciesMeta": {
    "testclaw": {
      "optional": true
    }
  },
  "testclaw": {
    "build": {
      "workerEntries": [
        "./src/memory/manager-search.worker.ts",
        "./src/memory/manager-index.worker.ts",
        "./src/memory/manager-publication.worker.ts"
      ]
    },
    "extensions": [
      "./index.js"
    ]
  }
}

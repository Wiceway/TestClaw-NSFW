{
  "name": "@testclaw/diffs",
  "version": "2026.9.5",
  "description": "Testclaw read-only diff viewer plugin and file renderer for agents.",
  "type": "module",
  "dependencies": {
    "@pierre/diffs": "1.4.2",
    "@shikijs/langs": "4.4.3",
    "playwright-core": "1.63.0",
    "typebox": "1.3.30",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testclaw/plugin-sdk": "workspace:*"
  },
  "testclaw": {
    "extensions": [
      "./index.js"
    ],
    "install": {
      "npmSpec": "@testclaw/diffs",
      "clawhubSpec": "clawhub:@testclaw/diffs",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.30"
    },
    "compat": {
      "pluginApi": ">=2026.9.5"
    },
    "assetScripts": {
      "build": "node --import tsx ../../scripts/build-diffs-viewer-runtime.mts curated"
    },
    "build": {
      "bundledDist": false,
      "testclawVersion": "2026.9.5",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
